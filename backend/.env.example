# Supabase -> Connect -> Direct -> Session pooler (URI). Put your real password in.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Comma-separated list of frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Supabase -> Project Settings -> API Keys -> Legacy API Keys -> service_role (secret!)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
# Storage bucket for uploaded files (create it as a PUBLIC bucket)
SUPABASE_BUCKET=archive

# Google Gemini (aistudio.google.com -> Get API key). Used for search + fact extraction.
GEMINI_API_KEY=

# Secret for maintenance jobs (/admin/*, imports, deleting files). Send it as the X-Admin-Token header.
# Leave empty to switch those jobs off.
ADMIN_TOKEN=
# Shared database connections per API instance (keep instances x DB_POOL_MAX under Supabase's pooler limit)
DB_POOL_MAX=8
